--- a/public/scene.js
+++ b/public/scene.js
@@ -707,7 +707,7 @@ if (MOBILE) ["outlandish", "allora", "starling", "estimator", "stash", "nella",
 });
 const FOOTPRINT = 3.1;
 /* Single-object models (no island, rocks or grass): stand them on the meadow at this width, in scene units */
-const STANDALONE = { outlandish: 2.1, allora: 1.55, starling: 1.7, estimator: 1.5, stash: 1.3, nella: 1.3, annie: 1.35 };
+const STANDALONE = { outlandish: 2.45, allora: 1.55, starling: 1.7, estimator: 1.5, stash: 1.3, nella: 1.3, annie: 1.35 };
 // Point the clock model's hands at the current time: each hand turns about the face normal through the centre cap
 function wireClockHands(model) {
   const get = n => model.getObjectByName(n), center = o => new THREE.Box3().setFromObject(o).getCenter(new THREE.Vector3());
@@ -727,7 +727,7 @@ function wireClockHands(model) {
     let tip = null, far = -1;
     for (let i = 0; i < pos.count; i++) { v.fromBufferAttribute(pos, i).applyMatrix4(w).sub(piv); v.addScaledVector(n, -v.dot(n)); if (v.lengthSq() > far) { far = v.lengthSq(); tip = v.clone(); } }
     // hang the hand from a pivot group at the cap so it turns in place
-    const g = new THREE.Group(); g.position.copy(piv); model.add(g); g.updateMatrixWorld(true);
+    const g = new THREE.Group(); g.userData.clockPivot = true; g.position.copy(piv); model.add(g); g.updateMatrixWorld(true);
     g.attach(h);
     return { g, a0: angleOf(tip) };
   });
@@ -747,7 +747,13 @@ function standalone(p, model, holder) {
   holder.userData.glb = true;
   if (update) { update(new Date()); holder.userData.updateTime = update; }
   // the whole object lifts on hover
-  const lift = []; model.traverse(o => { if (o.isMesh) lift.push(o); });
+  // clock hands live in rotating pivot groups: lift the pivot (whose parent doesn't turn), not the hand,
+  // or the lift direction spins with the hand and it drifts off the face
+  const lift = []; model.traverse(o => {
+    if (!o.isMesh) return;
+    const t = o.parent && o.parent.userData.clockPivot ? o.parent : o;
+    if (!lift.includes(t)) lift.push(t);
+  });
   holder.updateMatrixWorld(true);
   const toHolder = new THREE.Matrix4().copy(holder.matrixWorld).invert();
   holder.userData.liftParts = lift.map(o => {
@@ -1850,7 +1856,7 @@ window.__dbg = { THREE, camera, controls, objects, scene };
